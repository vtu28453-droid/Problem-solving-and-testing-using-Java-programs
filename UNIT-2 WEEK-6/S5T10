import java.util.*;

public class Solution {
    // Expand around center to find longest palindrome length
    private static int longestPalindromeLength(String s) {
        int n = s.length();
        int maxLen = 1;

        for (int center = 0; center < n; center++) {
            // Odd length palindrome
            int len1 = expand(s, center, center);
            // Even length palindrome
            int len2 = expand(s, center, center + 1);
            maxLen = Math.max(maxLen, Math.max(len1, len2));
        }
        return maxLen;
    }

    private static int expand(String s, int left, int right) {
        while (left >= 0 && right < s.length() && s.charAt(left) == s.charAt(right)) {
            left--;
            right++;
        }
        return right - left - 1;
    }

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        String s = sc.next();

        // Generate rotations using s+s
        String doubled = s + s;
        for (int i = 0; i < n; i++) {
            String rotation = doubled.substring(i, i + n);
            System.out.println(longestPalindromeLength(rotation));
        }
        sc.close();
    }
}
