import java.util.*;

public class Solution {
    // Z-function computation
    private static int[] computeZ(String s) {
        int n = s.length();
        int[] Z = new int[n];
        Z[0] = n;
        int l = 0, r = 0;
        for (int i = 1; i < n; i++) {
            if (i <= r) {
                Z[i] = Math.min(r - i + 1, Z[i - l]);
            }
            while (i + Z[i] < n && s.charAt(Z[i]) == s.charAt(i + Z[i])) {
                Z[i]++;
            }
            if (i + Z[i] - 1 > r) {
                l = i;
                r = i + Z[i] - 1;
            }
        }
        return Z;
    }

    public static long stringSimilarity(String s) {
        int[] Z = computeZ(s);
        long sum = 0;
        for (int val : Z) {
            sum += val;
        }
        return sum;
    }

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int t = sc.nextInt();
        while (t-- > 0) {
            String s = sc.next();
            System.out.println(stringSimilarity(s));
        }
        sc.close();
    }
}
